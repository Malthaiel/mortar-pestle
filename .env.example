# Mortar & Pestle — environment variable surface.
# Every value is intentionally EMPTY. Copy to .env (gitignored) and fill in as needed.
# Comment format: # <required/optional>; <source file:line> — <meaning>

# ── Frontend / build-time (read by web/vite.config.js or import.meta.env) ──

# optional (default "core"); web/src/module-loader.js:82 — "core"|"studio"; gates studio modules. Reference in exact import.meta.env form so the build folds the unused branch.
VITE_BUILD_TIER=

# optional (defaults to host platform); web/vite.config.js:19,27 — target-OS define for OS-gated code (manifest platforms filter).
VITE_TARGET_OS=

# optional; web/src/components/SettingsDrawer.jsx:71 — "1" keeps the Dev tab visible in a production build (dev builds show it regardless).
VITE_DEV_TOOLS=

# optional (default on); web/vite.config.js:13 — "0" opts out of component-id JSX attribute injection.
AOS_DESIGN=

# ── Backend (src-tauri/) ──

# optional for dev, REQUIRED for release build (src-tauri/build.rs panics without it); src-tauri/src/commands/feedback.rs:28,37 — public Supabase feedback-backend URL (option_env!-baked + runtime fallback; RLS-gated).
MORTAR_PESTLE_SUPABASE_URL=

# optional for dev, REQUIRED for release build (src-tauri/build.rs panics without it); src-tauri/src/commands/feedback.rs:29,53 — public Supabase anon key (RLS-gated, safe to ship).
MORTAR_PESTLE_SUPABASE_ANON_KEY=

# optional; src-tauri/src/commands/coaching.rs:326, src-tauri/src/commands/design.rs:143,166 — Anthropic agent API key. keyring-first; also settable in-app.
ANTHROPIC_API_KEY=

# optional; src-tauri/src/commands/vault.rs:25 — content-vault root path override.
AGENTIC_VAULT_ROOT=

# optional; src-tauri/src/commands/vault.rs:41 — app-vault root path override.
AGENTIC_APP_VAULT_ROOT=

# optional; src-tauri/src/commands/vault.rs:50 — pulse-vault root path override.
AGENTIC_PULSE_VAULT_ROOT=

# optional; src-tauri/src/commands/vault.rs:61, src-tauri/src/commands/vaults.rs:423 — library-vault root path override.
AGENTIC_LIBRARY_VAULT_ROOT=

# optional; src-tauri/src/commands/vault.rs:72, src-tauri/src/commands/vaults.rs:491 — gamewiki-vault root path override.
AGENTIC_GAMEWIKI_VAULT_ROOT=

# optional; src-tauri/src/commands/vault.rs:109 — captures directory path override.
AGENTIC_CAPTURES_ROOT=

# optional; src-tauri/src/commands/media.rs:32 — media-library roots override.
AGENTIC_MEDIA_ROOTS=

# optional; src-tauri/src/parsers/daily.rs:20 — overrides "today" for the daily-page parser (dev/test).
AGENTIC_TODAY=

# optional; src-tauri/src/commands/release.rs:52 — code-repo root path override (release publishing).
AGENTIC_CODE_ROOT=

# optional; src-tauri/src/commands/sidebar.rs:29 — app-config directory path override.
AGENTIC_APP_CONFIG_ROOT=

# optional; src-tauri/src/commands/qbit.rs:81 — qBittorrent Web UI password fallback (keyring-first; env is the fallback).
QBIT_PASS=

# optional (dev); src-tauri/src/lib.rs:619 — per-worktree dev window-title override (mortar-pestle_wt.py injects this so each worktree's window is distinguishable in Alt-Tab).
MORTAR_PESTLE_WT_TITLE=

# optional; src-tauri/src/capture/carriage.rs:62 — capture sidecar binary path override.
MORTAR_PESTLE_CAPTURE_BIN=

# optional; src-tauri/src/stt/carriage.rs:63 — STT sidecar binary path override.
MORTAR_PESTLE_STT_BIN=

# optional; src-tauri/src/broadcast/carriage.rs:58 — broadcast sidecar binary path override.
MORTAR_PESTLE_BROADCAST_BIN=