node_modules/
web/dist/
.DS_Store
.env
.env.local
*.log
.wt-dev-config.json

# Test-fixture render-cache byproducts (regenerated each cargo test run).
src-tauri/tests/fixtures/daily-vault/Infrastructure/.cache/
src-tauri/tests/fixtures/vault/Infrastructure/.cache/

# Tauri 2 AppManifest auto-generated permissions (regenerated each `tauri build`).
src-tauri/permissions/

# Rust build artifacts (all crates: src-tauri, mortar-pestle-stt, mortar-pestle-capture, nvenc-sys).
target/

# Bundled external tools (ffmpeg/ffprobe/yt-dlp) — dropped here at release-cut,
# resolved by src-tauri/src/tool_path.rs. Not committed; PATH fallback until then.
src-tauri/resources/bin/

# USDA food database (86 MB) — fetched by scripts/fetch-usda-db.mjs at build time
# (Release asset on Malthaiel/mortar-pestle, tag usda-db-v1). Not committed.
src-tauri/resources/usda_foods.db

# No-undo-net backups taken before bulk edits.
.bak/

# Boxicons source pack, read by web/scripts/gen-icons.mjs to regenerate the icon
# pack. Not a dependency of this repo (the app ships zero npm deps) — drop it
# here with `npm i boxicons` only when regenerating, or pass another path.
.iconpacks/

# DEV audit→chat bridge sink (Spacing Correctness System). Runtime scratch written
# by the Vite /__audit middleware; never committed.
web/.audit/

# Secrets — never commit. Tauri updater private key + signing material live in CI secrets.
.env.*
# .env.example is the public template — ship it; real .env files stay ignored above.
!.env.example
*.key
*.pem
tauri-signing-key*
.tauri/

# OS / editor junk.
Thumbs.db
Desktop.ini
*.swp
