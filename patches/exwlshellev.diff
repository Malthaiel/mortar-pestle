+    /// mortar-pestle patch: the next frame is drawn at `px` and carries this layout.
+    fn hold_layout(&mut self, anchor: Anchor, size: LayerSize, px: PhysicalSize<u32>) {
+        self.anchor = anchor;
+        self.layer_size = size;
+        self.pending_layout = Some((anchor, size));
+        if self.physical_size != px {
+            self.physical_size = px;
+            self.mark_resized();
+        }
+        self.request_refresh(RefreshRequest::NextFrame);
+    }
+
+    /// mortar-pestle patch: the held layout, sent just before the frame's picture
+    /// commits it (never committed here).
+    fn send_layout(&mut self) {
+        let (Some((anchor, size)), Shell::LayerShell(layer_shell)) = (self.pending_layout.take(), &self.shell) else {
+            return;
+        };
+        let (width, height) = size.to_set();
+        layer_shell.set_anchor(size.resolve_anchor(anchor));
+        layer_shell.set_size(width, height);
+    }
+
+    fn drop_probe(&mut self) {
+        if let Some((probe, surface, ..)) = self.probe.take() {
+            probe.destroy();
+            surface.destroy();
+        }
+    }
+
+    /// mortar-pestle patch: the sheet's size came; the layout waiting on it is held
+    /// for the next frame at that size. True when `surface` was this unit's sheet.
+    pub(crate) fn probed(&mut self, surface: &ZwlrLayerSurfaceV1, px: PhysicalSize<u32>) -> bool {
+        if !self.probe.as_ref().is_some_and(|(p, ..)| p == surface) {
+            return false;
+        }
+        let (_, _, anchor, size) = self.probe.clone().expect("checked");
+        self.drop_probe();
+        self.hold_layout(anchor, size, px);
+        true
+    }
