--- a/src/event.rs
+++ b/src/event.rs
@@ -10,11 +10,17 @@
 
 use iced_wayland_subscriber::ExWlOutputInfo;
 
+// Patched (mortar-pestle, 2026-11-03): upstream read every button but right and
+// middle as Left, so the mouse's back and forward came as left clicks. Linux's codes
+// (input-event-codes.h): BTN_LEFT 0x110, RIGHT, MIDDLE, SIDE (back), EXTRA (forward).
 fn from_u32_to_icedmouse(code: u32) -> mouse::Button {
     match code {
+        272 => mouse::Button::Left,
         273 => mouse::Button::Right,
         274 => mouse::Button::Middle,
-        _ => mouse::Button::Left,
+        275 => mouse::Button::Back,
+        276 => mouse::Button::Forward,
+        other => mouse::Button::Other(other as u16),
     }
 }
 
