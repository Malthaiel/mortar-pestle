+
+/// M&P: `Text::visible_bounds` puts a cached text's box at its anchor point, but the
+/// engine draws centred, right or bottom aligned text before that point (`text.rs`
+/// `draw_cached`), so a change missed that part of it: the top half of every
+/// vertically centred word (a fading highlight left half-lit letters in mp-shell's
+/// replay menu, 2026-11-04). The box moves as the engine moves the text, by its whole
+/// side (the text is never larger); an endless side takes the clip's.
+fn visible_bounds(text: &Text) -> Option<Rectangle> {
+    let Text::Cached { bounds, clip_bounds, align_x, align_y, .. } = text else {
+        return text.visible_bounds();
+    };
+    let along = |start: f32, size: f32, share: f32, clip: (f32, f32)| {
+        if share == 0.0 {
+            (start, size)
+        } else if size.is_finite() {
+            (start - size * share, size)
+        } else {
+            clip
+        }
+    };
+    let (x, width) = along(
+        bounds.x,
+        bounds.width,
+        match align_x {
+            core::text::Alignment::Center => 0.5,
+            core::text::Alignment::Right => 1.0,
+            _ => 0.0,
+        },
+        (clip_bounds.x, clip_bounds.width),
+    );
+    let (y, height) = along(
+        bounds.y,
+        bounds.height,
+        match align_y {
+            core::alignment::Vertical::Top => 0.0,
+            core::alignment::Vertical::Center => 0.5,
+            core::alignment::Vertical::Bottom => 1.0,
+        },
+        (clip_bounds.y, clip_bounds.height),
+    );
+    Rectangle { x, y, width, height }.intersection(clip_bounds)
+}
