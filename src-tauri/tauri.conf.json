{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mortar & Pestle",
  "version": "0.2.0",
  "identifier": "dev.malthaiel.mortar-pestle",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix web run dev",
    "beforeBuildCommand": "cargo build --release --manifest-path mortar-pestle-capture/Cargo.toml && cargo build --release --manifest-path mortar-pestle-stt/Cargo.toml --features vulkan && npm --prefix web run build && node scripts/rotate-binary.mjs && node scripts/fetch-usda-db.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mortar & Pestle",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "overlay-host",
        "title": "Mortar & Pestle Overlay",
        "url": "index.html#/overlay/host",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "overlay-toast",
        "title": "Mortar & Pestle Overlay Toast",
        "url": "index.html#/overlay/toast",
        "width": 420,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "scripts/download_album.py": "scripts/download_album.py",
      "scripts/download_anime.py": "scripts/download_anime.py",
      "scripts/import_music_parse.py": "scripts/import_music_parse.py",
      "scripts/import_mal_parse.py": "scripts/import_mal_parse.py",
      "scripts/import_watchlist_parse.py": "scripts/import_watchlist_parse.py",
      "resources/usda_foods.db": "resources/usda_foods.db",
      "resources/bin/mpv.exe": "bin/mpv.exe"
    },
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "publisher": "Malthaiel",
    "shortDescription": "Mortar & Pestle desktop shell",
    "longDescription": "Mortar & Pestle — a personal operating system for thinking, planning, and producing: vault browser, focus timer, skills runner, media player, and per-session-token PTY terminal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Malthaiel/mortar-pestle/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MjczODk4QzE1RkQ4M0UKUldRKzJGL0JtRGduZElDQTVJVXQrOVJNMUtJUzRrUkVwMi9qM0tmUGhpTnBkY2Vxd3NQVE53T28K"
    }
  }
}
